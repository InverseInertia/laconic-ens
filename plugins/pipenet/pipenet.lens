!plot GRUND_43100A(x), GRUND_43100B(x), GRUND_43100C(x),GRUND_2699A(x), GRUND_2699B(x), GRUND_2699C(x), GRUND_1542A(x), x = 0 'gal / 'min .. 60 'gal / ('min)
  title: "Grundfos Pump Curves"
  yunit: 'psi
  xunit: 'gal / 'min
