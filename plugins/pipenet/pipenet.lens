## Fitting Losses
# Each method's coefficients, one row per kind of fitting in N_fit!'s order: 90° elbow, tee run, tee branch.
# The values are for standard threaded fittings (r/D = 1); edit them to suit yours. Choose the method in the
# plugin (Network → Fitting losses), which writes fit_method! above.

# Crane TP-410: K = (L/D) * f_T. Column: L/D. f_T is the fully turbulent friction factor of clean commercial
# steel, the pipe Crane's L/D values were measured in, whatever the pipe here is made of.
FIT_Crane = [30; 20; 60]
ε_Crane = 0.046 'mm
f_T(d_h) = (log10(ε_Crane / (3.7 * d_h)))^-2 * 0.25

# Hooper 2-K: K = K_1 / Re + K_∞ * (1 + 1 / D), with D in inches. Columns: K_1, K_∞.
FIT_Hooper = [800, 0.40; 200, 0.10; 500, 0.70]
hooper_D(d) = 1 + 'in / d

# Darby 3-K: K = K_1 / Re + K_i * (1 + K_d / D^0.3), with D in inches. Columns: K_1, K_i, K_d.
FIT_Darby = [800, 0.14, 4; 200, 0.091, 4; 500, 0.274, 4]
darby_D(d) = (d / 'in)^-0.3

# Each segment's ΣK, for segments with fittings N, extra K K_x and diameters D carrying flows ∀`, by the
# method chosen. The supply and the return each call it with their own. The Reynolds numbers are worked out once.
w_fit = row(identity(3), fit_method!)
K_Crane(N, D) = (N * FIT_Crane) .* .f_T(D)
K_Hooper(N, D, Re_s) = (N * col(FIT_Hooper, 1)) ./ Re_s + (N * col(FIT_Hooper, 2)) .* .hooper_D(D)
K_Darby(N, D, Re_s) = (N * col(FIT_Darby, 1)) ./ Re_s + (N * col(FIT_Darby, 2)) + (N * (col(FIT_Darby, 2) .* col(FIT_Darby, 3))) .* .darby_D(D)
Re_seg(∀`, D) = .Re(D, .V@(D, ∀`))
ΣK_Re(Re_s, N, D, K_x) = idx(w_fit, 1) * K_Crane(N, D) + idx(w_fit, 2) * K_Hooper(N, D, Re_s) + idx(w_fit, 3) * K_Darby(N, D, Re_s) + K_x
ΣK(∀`, N, D, K_x) = ΣK_Re(Re_seg(∀`, D), N, D, K_x)

# Each segment's pressure drop, on the supply and on the return, for the flows ∀_des! to the spurs.
Δp_supply(∀_des!) = .ΔP_DW(ε_PVC, D_h!, A * ∀_des!, L!, ΣK(A * ∀_des!, N_fit!, D_h!, K_extra!))
Δp_return(∀_des!) = .ΔP_DW(ε_PVC, D_r!, A_r * ∀_des!, L_r!, ΣK(A_r * ∀_des!, N_fit_r!, D_r!, K_extra_r!))

## Pressure Drop Solver
# The main pump holds either the loop's total flow (hold_flow! 1: ∀_target) or its pressure difference
# (hold_flow! 0: Δp_target), as the plugin's Network → Pump holds sets. Either way the solver finds the spur
# flows ∀_des! and the pump's pressure difference Δp_main together.
# The start: each spur in the middle of its exchanger's data, so none starts against a wall, scaled to add up
# to the target flow when the pump holds one; and the pressure difference a path needs, on average, at those flows
∀_mid = .hx_mid(exchangers!) * ('gal / 'min)
∀_des! = ∀_mid * (hold_flow! * ∀_target / sum(∀_mid) + 1 - hold_flow!)
# What the path to each spur takes, less its circulator's head: out along the supply, through its exchanger and
# its regulating valve and back along the return. transpose(A) * Δp_supply and transpose(A_r) * Δp_return add up
# the segments each path passes through.
path_dp(∀_des!) = transpose(A) * Δp_supply(∀_des!) + transpose(A_r) * Δp_return(∀_des!) + .HX(∀_des!, exchangers!) + .VALVE(∀_des!, valves!) - .PUMP_sel(∀_des!, pumps!)
Δp_main = hold_flow! * sum(path_dp(∀_des!)) / cols(A) + (1 - hold_flow!) * Δp_target
# root solver finds the flows at which every path takes the pump's pressure difference, with the flows adding
# up to the target (holding a flow) or that pressure difference the target (holding it)
residual(∀_des!, Δp_main) = (path_dp(∀_des!) - Δp_main) / 'psi
!root ∀_des!, Δp_main
  equation: residual(∀_des!, Δp_main)
  equation: hold_flow! * (sum(∀_des!) - ∀_target) / ('gal / 'min) + (1 - hold_flow!) * (Δp_main - Δp_target) / 'psi
  method: solver_method!
  autorun: on
  status: solver_state
  #@ result {"hash":"0d12026367ea","kind":"root","method":"hybr","scipy":"1.18.1","values":[{"mag":[[0.000867391204062375],[0.0008652917166846526],[0.0008662525877852556],[0.000865721834192309],[0.0008663001513303419],[0.0008675452382911778],[0.0008694971064085907],[0.0008719217652452966]],"unit":"meter ** 3 / second"},{"mag":6220.46971965263,"unit":"pascal"}],"nfev":17,"message":"The solution converged.","resid":1.1e-08}
## Output
!short
∀! = A * ∀_des! -> 'gal / 'min
∀_r! = A_r * ∀_des! -> 'gal / 'min
ΣK_seg = ΣK(∀!, N_fit!, D_h!, K_extra!)
ΣK_r = ΣK(∀_r!, N_fit_r!, D_r!, K_extra_r!)
Δp_paths = Δp_supply(∀_des!) -> 'psi
Δp_r = Δp_return(∀_des!) -> 'psi
Δp_spur = transpose(A) * Δp_paths + transpose(A_r) * Δp_r -> 'psi
Δp_hx = .HX(∀_des!, exchangers!) -> 'psi
Δp_valve = .VALVE(∀_des!, valves!) -> 'psi
Δp_circ = .PUMP_sel(∀_des!, pumps!) -> 'psi
# The residual from the pieces above, rather than running the pipes' pressure drops again
Δp_residual = Δp_spur + Δp_hx + Δp_valve - Δp_circ - Δp_main -> 'psi
# the loop's total flow and the main pump's pressure difference: one of them its target, the other found
∀_total = sum(∀_des!) -> 'gal / 'min
Δp_pump = Δp_main -> 'psi
# Back to the drawing: flow, loss coefficient and pressure drop in each supply segment and (the names ending
# in _r) each return segment, the piping's pressure drop on each spur's path, supply and return, the loop's
# total flow and the pump's pressure difference; and how the solver stands (solver_state: 1 up to date,
# 0 out of date, -1 not run, -2 an error), for its banner
!pluginvar ∀!, ΣK_seg, Δp_paths, ∀_r!, ΣK_r, Δp_r, Δp_spur, Δp_valve, Δp_circ, ∀_total, Δp_pump, solver_state
